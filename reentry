#!/usr/bin/env bash
# reentry: backups that prove they restore.
# Exit codes: 0 ok, 1 command failed, 2 usage error, 3 prerequisite missing
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SELF="$ROOT/reentry"
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/compose/docker-compose.yml"
BACKUP_RE='^(.+)_([0-9]{8}T[0-9]{6}Z)\.sql\.gz(\.enc)?$'

log() { printf '%s reentry: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() {
  local code=$1; shift
  log "ERROR: $*"
  # a command and its engine processes share this file, so the failure notice can list the reasons
  [ -z "${_REENTRY_FAILS:-}" ] || printf '%s\n' "$*" >> "$_REENTRY_FAILS" || true
  exit "$code"
}

# Leftovers of the step in flight, removed on exit, Ctrl-C or kill.
CLEAN_BASE="" CLEAN_CONTAINER="" CLEAN_OFF=() NOTIFY_CTX=""
cleanup() {
  local rc=$?
  # a failed backup or verify sends a notice, Ctrl-C and kill (128 and up) do not
  # only the command that started the notice cleans up the shared file, its engine processes must not
  if [ -n "$NOTIFY_CTX" ]; then
    if [ "$rc" -ne 0 ] && [ "$rc" -lt 128 ]; then notify_failure "$NOTIFY_CTX" "$rc" || true; fi
    [ -z "${_REENTRY_FAILS:-}" ] || rm -f -- "$_REENTRY_FAILS"
  fi
  [ -z "$CLEAN_BASE" ] || rm -f -- "$CLEAN_BASE.partial" "$CLEAN_BASE.plain.partial" "$CLEAN_BASE.counts" "$CLEAN_BASE.sha256"
  [ -z "${CATALOG:-}" ] || rm -f -- "$CATALOG.tmp"
  [ "${#CLEAN_OFF[@]}" -eq 0 ] || rm -f -- "${CLEAN_OFF[@]}"
  [ -z "$CLEAN_CONTAINER" ] || docker rm -f "$CLEAN_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

need_tools() {
  [ "${BASH_VERSINFO[0]}" -ge 4 ] || die 3 "bash 4 or newer is required"
  local t
  for t in sha256sum gzip flock readlink; do
    command -v "$t" >/dev/null 2>&1 || die 3 "$t not found on PATH"
  done
  date -u -d 2026-01-01 +%G >/dev/null 2>&1 || die 3 "GNU date is required"
}

need_docker() { command -v docker >/dev/null 2>&1 || die 3 "docker not found on PATH"; }
need_env() { [ -f "$ENV_FILE" ] || die 3 ".env not found, copy .env.example to .env and set passwords"; }

# Reads the few settings the CLI needs from .env without running it as shell code.
# A value already in the environment wins, as it does in Docker Compose.
# Quote values that contain $ with single quotes. Inline comments are not supported.
parse_env() {
  [ -f "$ENV_FILE" ] || return 0
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
    case "$v" in
      \"*\") v="${v#\"}"; v="${v%\"}" ;;
      \'*\') v="${v#\'}"; v="${v%\'}" ;;
    esac
    case "$k" in
      MYSQL_DATABASE|POSTGRES_DB|REENTRY_*) [ -n "${!k+x}" ] || export "$k=$v" ;;
    esac
  done < "$ENV_FILE"
}

load_env() {
  MYSQL_DATABASE="${MYSQL_DATABASE:-shop}"
  POSTGRES_DB="${POSTGRES_DB:-shop}"
  [[ $MYSQL_DATABASE =~ ^[A-Za-z0-9_]+$ ]] || die 2 "MYSQL_DATABASE may only contain letters, digits and underscores"
  [[ $POSTGRES_DB =~ ^[A-Za-z0-9_]+$ ]] || die 2 "POSTGRES_DB may only contain letters, digits and underscores"
}

compose() { docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"; }

require_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null || true)" = "true" ] ||
    die 3 "container $1 is not running, start it with: ./reentry up"
}

# One backup, verify or prune at a time. Child processes inherit the lock on fd 9.
take_lock() {
  mkdir -p "$BACKUP_DIR"
  exec 9>"$BACKUP_DIR/.reentry.lock"
  flock -n 9 || die 1 "another reentry command is running (lock: $BACKUP_DIR/.reentry.lock)"
}

# engine_setup <engine>: sets db, src (source container)
engine_setup() {
  case "$1" in
    mysql) db=$MYSQL_DATABASE; src=reentry-mysql ;;
    postgres) db=$POSTGRES_DB; src=reentry-postgres ;;
    *) die 2 "unknown engine $1" ;;
  esac
}

# sql <engine> <container> <database> <statement>: prints bare values, one per line
sql() {
  local engine=$1 container=$2 db=$3 stmt=$4
  case "$engine" in
    mysql) docker exec -i "$container" sh -c \
      'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -h127.0.0.1 -uroot -N -B "$1" -e "$2"' _ "$db" "$stmt" ;;
    postgres) docker exec -i "$container" psql -U postgres -d "$db" -At -v ON_ERROR_STOP=1 -c "$stmt" ;;
  esac
}

# table_counts <engine> <container> <database>: "table=rows" per line, sorted by table
table_counts() {
  local engine=$1 container=$2 db=$3 list t q n bt='`' dq='"'
  case "$engine" in
    mysql) list="$(sql mysql "$container" "$db" "SELECT table_name FROM information_schema.tables WHERE table_schema='$db' AND table_type='BASE TABLE' ORDER BY 1")" || return 1 ;;
    postgres) list="$(sql postgres "$container" "$db" "SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY 1")" || return 1 ;;
  esac
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [ "$engine" = mysql ]; then q="$bt${t//$bt/$bt$bt}$bt"; else q="$dq${t//$dq/$dq$dq}$dq"; fi
    n="$(sql "$engine" "$container" "$db" "SELECT COUNT(*) FROM $q")" || return 1
    [[ $n =~ ^[0-9]+$ ]] || return 1
    printf '%s=%s\n' "$t" "$n"
  done <<<"$list"
}

# dump_to <engine> <container> <database>: writes a logical dump to stdout
dump_to() {
  case "$1" in
    mysql) docker exec "$2" sh -c \
      'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysqldump -uroot --single-transaction --routines --no-tablespaces "$1"' _ "$3" ;;
    postgres) docker exec "$2" pg_dump -U postgres --no-owner "$3" ;;
  esac
}

# index_names: reads file names on stdin and prints "key<TAB>file" for each backup, newest first
# within each key (engine_database)
index_names() {
  local n
  while IFS= read -r n; do
    [[ $n =~ $BACKUP_RE ]] || continue
    printf '%s\t%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$n"
  done | LC_ALL=C sort -t $'\t' -k1,1 -k2,2r | cut -f1,3
}

# backup_index: the same for the files in the backup folder
backup_index() {
  local f
  for f in "$BACKUP_DIR"/*.sql.gz "$BACKUP_DIR"/*.sql.gz.enc; do
    [ -e "$f" ] || continue
    printf '%s\n' "${f##*/}"
  done | index_names
}

latest_backup() {
  local k n
  while IFS=$'\t' read -r k n; do
    if [ "$k" = "$1_$2" ]; then printf '%s\n' "$n"; return 0; fi
  done < <(backup_index)
  return 0
}

# checksum_ok <file name>: the .sha256 file exists and every file it lists matches
checksum_ok() {
  [ -f "$BACKUP_DIR/$1.sha256" ] && (cd "$BACKUP_DIR" && sha256sum -c --status "$1.sha256" 2>/dev/null)
}

# The catalog is a tab separated file next to the backups, one row per backup:
# name, size, mtime, checksum state (ok, mismatch or none), when it was checked,
# off-host state (verified, failed or none) and when that was set. It is rewritten by
# backup, prune and status --refresh, always under the lock, through a temporary file.
# A row whose size and mtime are unchanged and was ok keeps its state without hashing the
# dump again. status --refresh hashes everything.

# catalog_rebuild [force]: rewrites the rows from the files in the backup folder and keeps
# the off-host columns of backups that are still there
catalog_rebuild() {
  local force="${1:-}" k n size mtime old cs checked now osize omtime ocs ochecked off off_at
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  while IFS=$'\t' read -r k n; do
    read -r size mtime < <(stat -c '%s %Y' -- "$BACKUP_DIR/$n")
    old=""; [ ! -f "$CATALOG" ] || old="$(awk -F'\t' -v n="$n" '$1==n' "$CATALOG")"
    osize="" omtime="" ocs="" ochecked="" off="" off_at=""
    [ -z "$old" ] || IFS=$'\t' read -r _ osize omtime ocs ochecked off off_at <<<"$old"
    if [ -z "$force" ] && [ "$ocs" = ok ] && [ "$osize" = "$size" ] && [ "$omtime" = "$mtime" ]; then
      cs=ok; checked="$ochecked"
    else
      if checksum_ok "$n"; then cs=ok
      elif [ -f "$BACKUP_DIR/$n.sha256" ]; then cs=mismatch
      else cs=none; fi
      checked="$now"
    fi
    [ -n "$off" ] || { off=none; off_at=-; }
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$size" "$mtime" "$cs" "$checked" "$off" "$off_at"
  done < <(backup_index) > "$CATALOG.tmp"
  mv -f -- "$CATALOG.tmp" "$CATALOG"
}

# catalog_set_off <file name> <verified|failed|none>: records the off-host state of one backup
catalog_set_off() {
  [ -f "$CATALOG" ] || return 0
  awk -F'\t' -v OFS='\t' -v n="$1" -v s="$2" -v t="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '$1==n{$6=s;$7=t} {print}' "$CATALOG" > "$CATALOG.tmp" &&
    mv -f -- "$CATALOG.tmp" "$CATALOG"
}

# catalog_update: a catalog problem is logged and never fails a backup or a prune
catalog_update() { catalog_rebuild "$@" || log "WARN could not update the catalog $CATALOG"; }

# catalog_field <file name> <column number>: one field of a backup's catalog row
catalog_field() { [ -f "$CATALOG" ] && awk -F'\t' -v n="$1" -v c="$2" '$1==n{print $c; exit}' "$CATALOG"; }

# Optional encryption at rest. REENTRY_ENCRYPT is gpg or openssl and REENTRY_ENCRYPT_KEY_FILE
# names a file whose first line is the passphrase. The passphrase is never put on a command line.
ENC_TOOL=""
need_key() {
  local k="${REENTRY_ENCRYPT_KEY_FILE:-}"
  [ -n "$k" ] || die 2 "REENTRY_ENCRYPT_KEY_FILE must name the file that holds the encryption passphrase"
  { [ -f "$k" ] && [ -r "$k" ] && [ -s "$k" ]; } || die 3 "encryption key file $k is missing, unreadable or empty"
}

# need_key_for <file name>: an encrypted backup needs the key before anything else is tried
need_key_for() { case "$1" in *.enc) need_key ;; esac; }

encrypt_setup() {
  ENC_TOOL="${REENTRY_ENCRYPT:-}"
  case "$ENC_TOOL" in
    "") return 0 ;;
    gpg|openssl) ;;
    *) die 2 "REENTRY_ENCRYPT must be gpg or openssl, got '$ENC_TOOL'" ;;
  esac
  command -v "$ENC_TOOL" >/dev/null 2>&1 || die 3 "$ENC_TOOL not found on PATH, it is needed for REENTRY_ENCRYPT=$ENC_TOOL"
  need_key
  if [ -n "$(find "$REENTRY_ENCRYPT_KEY_FILE" -maxdepth 0 -perm /077 2>/dev/null)" ]; then
    log "WARN $REENTRY_ENCRYPT_KEY_FILE can be read by other users, restrict it with chmod 600"
  fi
}

# encrypt_stream: encrypts stdin to stdout with the configured tool
encrypt_stream() {
  case "$ENC_TOOL" in
    openssl) openssl enc -aes-256-cbc -pbkdf2 -salt -pass "file:$REENTRY_ENCRYPT_KEY_FILE" ;;
    gpg) gpg --batch --quiet --yes --pinentry-mode loopback --passphrase-file "$REENTRY_ENCRYPT_KEY_FILE" \
      --symmetric --cipher-algo AES256 --compress-algo none -o - ;;
  esac
}

# read_backup <file name>: the gzip stream of a backup on stdout, decrypted if it is encrypted.
# The tool is told apart by the file header, so it does not depend on the current setting.
read_backup() {
  local f="$BACKUP_DIR/$1"
  case "$1" in
    *.enc)
      need_key
      if head -c 8 -- "$f" | grep -aqx 'Salted__'; then
        openssl enc -d -aes-256-cbc -pbkdf2 -pass "file:$REENTRY_ENCRYPT_KEY_FILE" -in "$f"
      else
        gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$REENTRY_ENCRYPT_KEY_FILE" -d "$f"
      fi ;;
    *) cat -- "$f" ;;
  esac
}

# Optional failure notice. REENTRY_NOTIFY_CMD is a shell command run with REENTRY_EVENT and
# REENTRY_MESSAGE in its environment, and REENTRY_NOTIFY_WEBHOOK is a URL that gets a JSON
# POST with event and text. Both come from .env, which is where a webhook secret belongs. The
# URL goes to curl on stdin so it never shows in a process list. Nothing is sent when neither
# is set, and a problem sending is only a warning, it never changes the exit code of the run.

# notify_begin <backup|verify>: from here on a failure of this command sends a notice
notify_begin() {
  NOTIFY_CTX=$1
  [ -n "${REENTRY_NOTIFY_CMD:-}${REENTRY_NOTIFY_WEBHOOK:-}" ] || return 0
  _REENTRY_FAILS="$(mktemp)"; export _REENTRY_FAILS
}

json_escape() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# notify <event> <message>
notify() {
  local ev=$1 msg=$2 url="${REENTRY_NOTIFY_WEBHOOK:-}"
  if [ -n "${REENTRY_NOTIFY_CMD:-}" ]; then
    REENTRY_EVENT="$ev" REENTRY_MESSAGE="$msg" timeout 30 bash -c "$REENTRY_NOTIFY_CMD" >/dev/null 2>&1 ||
      log "WARN notify: REENTRY_NOTIFY_CMD failed or timed out"
  fi
  if [ -n "$url" ]; then
    if [[ ! $url =~ ^https?://[^[:space:]\"\\]+$ ]]; then
      log "WARN notify: REENTRY_NOTIFY_WEBHOOK is not an http or https URL"
    elif ! command -v curl >/dev/null 2>&1; then
      log "WARN notify: curl not found, the webhook was not called"
    else
      printf 'url = "%s"\n' "$url" |
        curl --config - -sS --fail --max-time 10 -X POST -H 'Content-Type: application/json' \
          --data "{\"event\":\"$(json_escape "$ev")\",\"text\":\"$(json_escape "$msg")\"}" >/dev/null 2>&1 ||
        log "WARN notify: the webhook call failed"
    fi
  fi
}

# notify_failure <backup|verify> <exit code>. The event is backup-failed, verify-failed, or
# offhost-failed when the only thing that went wrong in a backup was the off-host copy.
notify_failure() {
  local ctx=$1 rc=$2 event="$1-failed" reasons="" line only_offhost=0
  [ -n "${REENTRY_NOTIFY_CMD:-}${REENTRY_NOTIFY_WEBHOOK:-}" ] || return 0
  if [ -n "${_REENTRY_FAILS:-}" ] && [ -s "$_REENTRY_FAILS" ]; then
    while IFS= read -r line; do
      case "$line" in
        *": FAILED, see the errors above") ;;
        *"off-host copy FAILED"*) [ "$only_offhost" = 2 ] || only_offhost=1; reasons="$reasons$line. " ;;
        *) only_offhost=2; reasons="$reasons$line. " ;;
      esac
    done < "$_REENTRY_FAILS"
  fi
  if [ "$ctx" = backup ] && [ "$only_offhost" = 1 ]; then event=offhost-failed; fi
  notify "$event" "reentry $ctx failed on $(hostname 2>/dev/null || echo host) with exit code $rc. ${reasons:-no detail recorded}"
}

# offhost_setup: reads REENTRY_OFFHOST_DEST and sets OFFHOST_KIND (none, path or remote),
# OFFHOST_HOST and OFFHOST_PATH. A destination like host:/dir goes over rsync and ssh,
# anything else is a folder, for example a mounted share.
OFFHOST_KIND=none OFFHOST_HOST="" OFFHOST_PATH=""
offhost_setup() {
  local d="${REENTRY_OFFHOST_DEST:-}" t
  OFFHOST_KIND=none
  [ -n "$d" ] || return 0
  [[ $d =~ ^[A-Za-z0-9_./@:+-]+$ ]] || die 2 "REENTRY_OFFHOST_DEST may only contain letters, digits and _ . / @ : + -"
  if [[ $d =~ ^([^/:]+):(.+)$ ]]; then
    for t in rsync ssh; do command -v "$t" >/dev/null 2>&1 || die 3 "$t not found on PATH, it is needed for a remote REENTRY_OFFHOST_DEST"; done
    OFFHOST_KIND=remote OFFHOST_HOST="${BASH_REMATCH[1]}" OFFHOST_PATH="${BASH_REMATCH[2]}"
  else
    OFFHOST_KIND=path OFFHOST_PATH="$d"
    [ "$(readlink -m -- "$d")" != "$(readlink -m -- "$BACKUP_DIR")" ] || die 2 "REENTRY_OFFHOST_DEST is the backup folder itself"
  fi
}

# offhost_discard <file name>: best effort removal of a copy that failed its check
offhost_discard() {
  local f
  for f in "$1" "$1.counts" "$1.sha256"; do
    case "$OFFHOST_KIND" in
      path) rm -f -- "$OFFHOST_PATH/$f" ;;
      remote) ssh "$OFFHOST_HOST" "rm -f -- '$OFFHOST_PATH/$f'" >/dev/null 2>&1 || true ;;
    esac
  done
}

# offhost_copy <file name>: copies the dump and its sidecars, then re-checks the SHA-256 file at
# the destination. Returns 1 on any problem. It never touches the local backup.
offhost_copy() {
  local name=$1 f
  local -a files=("$name")
  if [ "$OFFHOST_KIND" = none ]; then
    log "backup: off-host copy skipped, REENTRY_OFFHOST_DEST is not set"
    return 0
  fi
  [ ! -f "$BACKUP_DIR/$name.counts" ] || files+=("$name.counts")
  files+=("$name.sha256")
  case "$OFFHOST_KIND" in
    path)
      # never create the folder, an unmounted share would then fill the local disk
      [ -d "$OFFHOST_PATH" ] && [ -w "$OFFHOST_PATH" ] || { log "ERROR: off-host folder $OFFHOST_PATH is missing or not writable"; return 1; }
      for f in "${files[@]}"; do
        CLEAN_OFF+=("$OFFHOST_PATH/.$f.tmp")
        cp -- "$BACKUP_DIR/$f" "$OFFHOST_PATH/.$f.tmp" && mv -f -- "$OFFHOST_PATH/.$f.tmp" "$OFFHOST_PATH/$f" ||
          { log "ERROR: could not copy $f to $OFFHOST_PATH"; offhost_discard "$name"; return 1; }
      done
      (cd "$OFFHOST_PATH" && sha256sum -c --status "$name.sha256" 2>/dev/null) ||
        { log "ERROR: the copy of $name at $OFFHOST_PATH fails its SHA-256 check"; offhost_discard "$name"; return 1; } ;;
    remote)
      (cd "$BACKUP_DIR" && rsync -a -- "${files[@]}" "$OFFHOST_HOST:$OFFHOST_PATH/") ||
        { log "ERROR: rsync to $OFFHOST_HOST:$OFFHOST_PATH failed"; offhost_discard "$name"; return 1; }
      ssh "$OFFHOST_HOST" "cd '$OFFHOST_PATH' && sha256sum -c --status '$name.sha256'" >/dev/null 2>&1 ||
        { log "ERROR: the copy of $name at $OFFHOST_HOST:$OFFHOST_PATH fails its SHA-256 check"; offhost_discard "$name"; return 1; } ;;
  esac
  log "backup: off-host copy of $name verified at ${REENTRY_OFFHOST_DEST}"
}

# Runs in its own process (see cmd_backup) so one engine failing never stops the other.
cmd_backup_engine() {
  local engine=$1 db src stamp name base plain marker before after after_tail hash manifest=0
  need_docker; load_env; engine_setup "$engine"; encrypt_setup; offhost_setup
  require_running "$src"
  case "$engine" in mysql) marker='Dump completed' ;; postgres) marker='dump complete' ;; esac
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  name="${engine}_${db}_${stamp}.sql.gz${ENC_TOOL:+.enc}"
  base="$BACKUP_DIR/$name"
  plain="$base.partial"; [ -z "$ENC_TOOL" ] || plain="$base.plain.partial"
  CLEAN_BASE="$base"

  before="$(table_counts "$engine" "$src" "$db")" || die 1 "backup $engine/$db: could not read table counts"
  log "backup $engine/$db: dumping from $src"
  dump_to "$engine" "$src" "$db" | gzip -9 > "$plain" || die 1 "backup $engine/$db: dump failed"
  after="$(table_counts "$engine" "$src" "$db")" || die 1 "backup $engine/$db: could not read table counts"

  gzip -t "$plain" || die 1 "backup $engine/$db: dump is not valid gzip"
  # gzip -t cannot tell a finished dump from a cut-off one, so look for the dump's closing comment
  after_tail="$(gzip -dc "$plain" | tail -n 10)" || die 1 "backup $engine/$db: could not read the dump back"
  grep -q "$marker" <<<"$after_tail" || die 1 "backup $engine/$db: dump looks incomplete (no '$marker' trailer)"

  if [ -n "$before" ] && [ "$before" = "$after" ]; then
    printf '%s\n' "$before" > "$base.counts"; manifest=1
  else
    log "backup $engine/$db: WARN source changed during the dump, no row count manifest written, verify will compare with the live source"
  fi

  # the checksum covers the file as stored, so it can be checked without the key
  if [ -n "$ENC_TOOL" ]; then
    encrypt_stream < "$plain" > "$base.partial" || die 1 "backup $engine/$db: encryption with $ENC_TOOL failed"
    rm -f -- "$plain"
  fi

  # sidecar first, dump last: a crash leaves at worst an orphan sidecar, never a backup without one
  hash="$(sha256sum < "$base.partial" | cut -d' ' -f1)"
  {
    printf '%s  %s\n' "$hash" "$name"
    if [ "$manifest" = 1 ]; then (cd "$BACKUP_DIR" && sha256sum "$name.counts"); fi
  } > "$base.sha256"
  mv "$base.partial" "$base"
  CLEAN_BASE=""
  log "backup $engine/$db: ok $name ($(wc -c < "$base" | tr -d ' ') bytes, $([ -n "$ENC_TOOL" ] && echo "encrypted with $ENC_TOOL" || echo plaintext), row counts $([ "$manifest" = 1 ] && echo recorded || echo not recorded))"
  catalog_update
  if offhost_copy "$name"; then
    [ "$OFFHOST_KIND" = none ] || catalog_set_off "$name" verified
  else
    catalog_set_off "$name" failed
    die 1 "backup $engine/$db: off-host copy FAILED, the local backup $name is kept"
  fi
}

run_engines() { # run_engines <internal command>: runs both engines, returns the worst exit code
  local engine rc=0 r
  for engine in mysql postgres; do
    bash "$SELF" "$1" "$engine" || { r=$?; [ "$r" -le "$rc" ] || rc=$r; }
  done
  return "$rc"
}

cmd_backup() {
  notify_begin backup
  encrypt_setup; offhost_setup
  take_lock
  run_engines _backup-engine || die $? "backup: FAILED, see the errors above"
  log "backup: done"
}

wait_ready() {
  local engine=$1 container=$2 i=0
  while [ "$i" -lt 60 ]; do
    # TCP only answers on the final server, not the temporary one the image runs while initialising
    case "$engine" in
      mysql) docker exec "$container" sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysqladmin ping -h127.0.0.1 -uroot --silent' >/dev/null 2>&1 && return 0 ;;
      postgres) docker exec "$container" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && return 0 ;;
    esac
    sleep 2; i=$((i+1))
  done
  return 1
}

# integrity_check <engine> <container> <database> <table counts>
integrity_check() {
  local engine=$1 c=$2 db=$3 tables=$4 q="${REENTRY_INTEGRITY_SQL:-}" got
  if [ -z "$q" ]; then
    if grep -qx 'orders=.*' <<<"$tables" && grep -qx 'order_items=.*' <<<"$tables"; then
      # default check, written for the sample schema: no order_items row without a parent order
      q="SELECT COUNT(*) FROM order_items oi LEFT JOIN orders o ON o.id = oi.order_id WHERE o.id IS NULL"
    else
      log "verify $engine/$db: WARN no orders and order_items tables and REENTRY_INTEGRITY_SQL not set, skipping the integrity query"
    fi
  fi
  if [ -n "$q" ]; then
    got="$(sql "$engine" "$c" "$db" "$q")" || die 1 "verify $engine/$db: the integrity query failed to run"
    [ "$got" = 0 ] || die 1 "verify $engine/$db: integrity query returned '$got', expected 0"
  fi
  case "$engine" in
    mysql)
      got="$(docker exec "$c" sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysqlcheck -h127.0.0.1 -uroot --check "$1"' _ "$db")" ||
        die 1 "verify $engine/$db: mysqlcheck failed"
      ! grep -qvE 'OK$' <<<"$got" || die 1 "verify $engine/$db: mysqlcheck reported problems" ;;
    postgres)
      got="$(sql postgres "$c" "$db" "SELECT COUNT(*) FROM pg_constraint WHERE NOT convalidated")" ||
        die 1 "verify $engine/$db: constraint check failed to run"
      [ "$got" = 0 ] || die 1 "verify $engine/$db: $got constraints are not valid" ;;
  esac
}

# restore_into <engine> <container> <database> <file name> [single]: loads a dump into an existing
# database. With "single" a PostgreSQL load runs as one transaction, so a failure changes nothing.
restore_into() {
  local engine=$1 c=$2 db=$3 name=$4 single=${5:-}
  case "$engine" in
    mysql) read_backup "$name" | gzip -dc | docker exec -i "$c" sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -h127.0.0.1 -uroot "$1"' _ "$db" ;;
    postgres)
      if [ "$single" = single ]; then
        read_backup "$name" | gzip -dc | docker exec -i "$c" psql -U postgres -d "$db" -q -v ON_ERROR_STOP=1 -1 -f - -o /dev/null
      else
        read_backup "$name" | gzip -dc | docker exec -i "$c" psql -U postgres -d "$db" -q -v ON_ERROR_STOP=1 -o /dev/null
      fi ;;
  esac
}

# Runs in its own process (see cmd_verify) so set -e and die work normally for one engine.
cmd_verify_engine() {
  local engine=$1 db src image name tmp want got
  need_docker; load_env; engine_setup "$engine"
  require_running "$src"

  name="$(latest_backup "$engine" "$db")"
  [ -n "$name" ] || die 1 "verify $engine/$db: no backup found in $BACKUP_DIR"
  log "verify $engine/$db: latest backup is $name"
  need_key_for "$name"
  checksum_ok "$name" || die 1 "verify $engine/$db: checksum file missing or SHA-256 mismatch for $name"
  read_backup "$name" | gzip -t || die 1 "verify $engine/$db: $name cannot be decrypted or is not valid gzip"
  log "verify $engine/$db: checksum and gzip ok"

  # same image as the source, no network, removed when the process exits
  image="$(docker inspect -f '{{.Config.Image}}' "$src")" || die 1 "verify $engine/$db: cannot read the image of $src"
  tmp="reentry-verify-$engine-$$"
  CLEAN_CONTAINER="$tmp"
  log "verify $engine/$db: starting throwaway container $tmp from $image"
  case "$engine" in
    mysql) docker run -d --rm --network none --label reentry.verify=1 --name "$tmp" \
      -e MYSQL_ROOT_PASSWORD=verify -e "MYSQL_DATABASE=$db" "$image" >/dev/null ;;
    postgres) docker run -d --rm --network none --label reentry.verify=1 --name "$tmp" \
      -e POSTGRES_PASSWORD=verify -e "POSTGRES_DB=$db" "$image" >/dev/null ;;
  esac || die 1 "verify $engine/$db: could not start the throwaway container"
  wait_ready "$engine" "$tmp" || die 1 "verify $engine/$db: throwaway container did not become ready"

  log "verify $engine/$db: restoring $name"
  restore_into "$engine" "$tmp" "$db" "$name" || die 1 "verify $engine/$db: restore failed"

  if [ -f "$BACKUP_DIR/$name.counts" ]; then
    want="$(cat "$BACKUP_DIR/$name.counts")"
    log "verify $engine/$db: comparing with the row counts recorded at backup time"
  else
    want="$(table_counts "$engine" "$src" "$db")" || die 1 "verify $engine/$db: could not read source table counts"
    log "verify $engine/$db: WARN no row count manifest, comparing with the live source, writes since the backup will show as a mismatch"
  fi
  got="$(table_counts "$engine" "$tmp" "$db")" || die 1 "verify $engine/$db: could not read restored table counts"
  [ -n "$want" ] || die 1 "verify $engine/$db: no tables to compare"
  if [ "$want" != "$got" ]; then
    log "verify $engine/$db: expected row counts:"; printf '%s\n' "$want" >&2
    log "verify $engine/$db: restored row counts:"; printf '%s\n' "$got" >&2
    die 1 "verify $engine/$db: row counts differ"
  fi
  log "verify $engine/$db: row counts match ($(printf '%s' "$want" | tr '\n' ' '))"

  integrity_check "$engine" "$tmp" "$db" "$got"
  log "verify $engine/$db: integrity checks ok"
  log "verify $engine/$db: PASS $name"
}

cmd_verify() {
  notify_begin verify
  take_lock
  run_engines _verify-engine || die $? "verify: FAILED, see the errors above"
  log "verify: all latest backups restore and match"
}

# db_exists <engine> <container> <database>: succeeds if the database exists on the target
db_exists() {
  local n
  case "$1" in
    mysql) n="$(sql mysql "$2" information_schema "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='$3'")" || return 1 ;;
    postgres) n="$(sql postgres "$2" postgres "SELECT COUNT(*) FROM pg_database WHERE datname='$3'")" || return 1 ;;
  esac
  [ "$n" = 1 ]
}

# create_db <engine> <container> <database>
create_db() {
  case "$1" in
    mysql) docker exec "$2" sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -h127.0.0.1 -uroot -e "CREATE DATABASE \`$1\`"' _ "$3" ;;
    postgres) docker exec "$2" psql -U postgres -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"$3\"" ;;
  esac
}

# Restores a chosen backup into a database the user picks. Unlike verify it writes to a
# container that is not a throwaway, so it asks first unless the target is a verify container.
cmd_restore() {
  local engine="${1:-}" name="" target="" rdb="" yes=0 db src key want got existing answer label
  [ $# -gt 0 ] || die 2 "restore: name an engine, mysql or postgres"
  shift
  case "$engine" in mysql|postgres) ;; *) die 2 "restore: engine must be mysql or postgres, got '$engine'" ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      --backup|--target|--database)
        [ $# -ge 2 ] || die 2 "restore: $1 needs a value"
        case "$1" in --backup) name=$2 ;; --target) target=$2 ;; --database) rdb=$2 ;; esac
        shift ;;
      *) die 2 "restore: unknown option $1" ;;
    esac
    shift
  done
  need_docker; load_env; engine_setup "$engine"
  [ -n "$target" ] || target=$src
  [[ $target =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die 2 "restore: bad container name '$target'"
  [ -z "$rdb" ] || [[ $rdb =~ ^[A-Za-z0-9_]+$ ]] || die 2 "restore: --database may only contain letters, digits and underscores"

  take_lock
  if [ -n "$name" ]; then
    [[ $name =~ $BACKUP_RE ]] && [[ ${BASH_REMATCH[1]} == "${engine}_"* ]] ||
      die 2 "restore: '$name' is not a $engine backup file name"
    key="${BASH_REMATCH[1]}"; db="${key#"${engine}_"}"
    [ -f "$BACKUP_DIR/$name" ] || die 1 "restore: $name not found in $BACKUP_DIR"
  else
    name="$(latest_backup "$engine" "$db")"
    [ -n "$name" ] || die 1 "restore $engine/$db: no backup found in $BACKUP_DIR"
  fi
  [ -n "$rdb" ] || rdb=$db
  label="restore $engine/$rdb"
  log "$label: using $name"
  need_key_for "$name"
  checksum_ok "$name" || die 1 "$label: checksum file missing or SHA-256 mismatch for $name"
  read_backup "$name" | gzip -t || die 1 "$label: $name cannot be decrypted or is not valid gzip"
  require_running "$target"

  existing=""
  if db_exists "$engine" "$target" "$rdb"; then
    existing="$(table_counts "$engine" "$target" "$rdb")" || die 1 "$label: could not read the tables of $target"
    if [ "$engine" = postgres ] && [ -n "$existing" ]; then
      die 1 "$label: database $rdb on $target already has tables, restore into an empty database with --database NAME"
    fi
  fi

  if [ "$(docker inspect -f '{{index .Config.Labels "reentry.verify"}}' "$target" 2>/dev/null || true)" = 1 ]; then
    log "$label: $target is a throwaway verify container, no confirmation needed"
  elif [ "$yes" = 1 ]; then
    log "$label: --yes given, writing into $target without asking"
  else
    [ -t 0 ] || die 2 "restore writes into container $target, pass --yes to confirm"
    printf 'About to restore %s into database %s on container %s.\n' "$name" "$rdb" "$target" >&2
    if [ -n "$existing" ]; then printf 'The database has %s tables. Tables with the same names will be replaced.\n' "$(grep -c . <<<"$existing")" >&2; fi
    read -r -p "Type yes to go on: " answer
    [ "$answer" = yes ] || die 1 "aborted, nothing was written"
  fi

  db_exists "$engine" "$target" "$rdb" || { log "$label: creating database $rdb on $target"; create_db "$engine" "$target" "$rdb" || die 1 "$label: could not create database $rdb"; }
  log "$label: restoring $name into $target"
  restore_into "$engine" "$target" "$rdb" "$name" single || die 1 "$label: restore failed, the target may be partly loaded"

  if [ -f "$BACKUP_DIR/$name.counts" ]; then
    want="$(cat "$BACKUP_DIR/$name.counts")"
    got="$(table_counts "$engine" "$target" "$rdb")" || die 1 "$label: restored, but could not read table counts to check them"
    if [ "$want" != "$got" ]; then
      log "$label: expected row counts:"; printf '%s\n' "$want" >&2
      log "$label: row counts now in $target:"; printf '%s\n' "$got" >&2
      die 1 "$label: row counts differ from the backup"
    fi
    log "$label: row counts match ($(printf '%s' "$want" | tr '\n' ' '))"
  else
    log "$label: WARN no row count manifest, row counts were not checked"
  fi
  log "$label: done, $name is in database $rdb on $target"
}

# What prune_group checks and removes. Locally these are checksum_ok and local_rm. For the
# off-host copies prune_offhost points them at off_check and off_rm.
PRUNE_OK=checksum_ok PRUNE_RM=local_rm PRUNE_LABEL=prune
local_rm() { rm -f -- "$BACKUP_DIR/$1" "$BACKUP_DIR/$1.sha256" "$BACKUP_DIR/$1.counts"; }

# Keeps the newest backup of each of the last N days, ISO weeks and months that have one.
# Returns 1 and leaves the group alone if its newest backup fails its checksum, so a group
# always keeps at least one good copy.
prune_group() {
  local dry=$1 keep_d=$2 keep_w=$3 keep_m=$4; shift 4
  local f stamp day week month nd=0 nw=0 nm=0 keep
  declare -A sd sw sm
  if ! "$PRUNE_OK" "$1"; then
    log "ERROR: $PRUNE_LABEL: newest backup $1 fails its checksum, leaving its group untouched"
    return 1
  fi
  for f in "$@"; do
    [[ $f =~ $BACKUP_RE ]]; stamp="${BASH_REMATCH[2]}"
    day="${stamp:0:8}"; month="${stamp:0:6}"
    week="$(date -u -d "${day:0:4}-${day:4:2}-${day:6:2}" +%G-%V)"
    keep=0
    [ "$f" != "$1" ] || keep=1 # the newest backup of a group is never pruned, even with all limits at 0
    if [ -z "${sd[$day]:-}" ] && [ "$nd" -lt "$keep_d" ]; then sd[$day]=1; nd=$((nd+1)); keep=1; fi
    if [ -z "${sw[$week]:-}" ] && [ "$nw" -lt "$keep_w" ]; then sw[$week]=1; nw=$((nw+1)); keep=1; fi
    if [ -z "${sm[$month]:-}" ] && [ "$nm" -lt "$keep_m" ]; then sm[$month]=1; nm=$((nm+1)); keep=1; fi
    if [ "$keep" = 1 ]; then
      log "$PRUNE_LABEL: keep $f"
    elif [ "$dry" = 1 ]; then
      log "$PRUNE_LABEL: would delete $f"
    else
      "$PRUNE_RM" "$f"
      log "$PRUNE_LABEL: deleted $f"
    fi
  done
}

# Removes sidecars with no backup and leftover .partial files. Safe because the lock is held.
prune_orphans() {
  local dry=$1 f
  for f in "$BACKUP_DIR"/*.sql.gz{,.enc}.{sha256,counts,partial} "$BACKUP_DIR"/*.sql.gz{,.enc}.plain.partial; do
    [ -e "$f" ] || continue
    case "$f" in *.partial) ;; *) [ ! -e "${f%.*}" ] || continue ;; esac
    if [ "$dry" = 1 ]; then log "prune: would delete orphan ${f##*/}"; else rm -f -- "$f"; log "prune: deleted orphan ${f##*/}"; fi
  done
}

# prune_index <dry> <daily> <weekly> <monthly>: applies retention to "key<TAB>file" lines on stdin,
# one group (engine and database) at a time. Returns 1 if any group was left alone.
prune_index() {
  local dry=$1 d=$2 w=$3 m=$4 key n last="" rc=0
  local -a group=()
  while IFS=$'\t' read -r key n; do
    if [ -n "$last" ] && [ "$key" != "$last" ]; then
      prune_group "$dry" "$d" "$w" "$m" "${group[@]}" || rc=1
      group=()
    fi
    group+=("$n"); last="$key"
  done
  if [ "${#group[@]}" -gt 0 ]; then prune_group "$dry" "$d" "$w" "$m" "${group[@]}" || rc=1; fi
  return "$rc"
}

# off_check <file name>: the copy at the off-host destination passes its SHA-256 file there
off_check() {
  case "$OFFHOST_KIND" in
    path) [ -f "$OFFHOST_PATH/$1.sha256" ] && (cd "$OFFHOST_PATH" && sha256sum -c --status "$1.sha256" 2>/dev/null) ;;
    remote) ssh "$OFFHOST_HOST" "cd '$OFFHOST_PATH' && sha256sum -c --status '$1.sha256'" >/dev/null 2>&1 ;;
  esac
}

# off_rm <file name>: removes one off-host copy and records that in the catalog
off_rm() { offhost_discard "$1"; catalog_set_off "$1" none; }

# offhost_list: file names at the destination. Fails if the destination cannot be read, which
# must never be mistaken for an empty destination.
offhost_list() {
  case "$OFFHOST_KIND" in
    path) [ -d "$OFFHOST_PATH" ] && ls -1 -- "$OFFHOST_PATH" ;;
    remote) ssh "$OFFHOST_HOST" "ls -1 -- '$OFFHOST_PATH'" ;;
  esac
}

# prune_offhost <dry> <daily> <weekly> <monthly>: the same retention on the off-host copies, only
# when REENTRY_OFFHOST_DEST is set. A group whose newest copy fails its check there is left alone.
prune_offhost() {
  local listing r=0
  [ "$OFFHOST_KIND" != none ] || return 0
  log "prune: off-host retention at $REENTRY_OFFHOST_DEST, keeping $2 daily, $3 weekly, $4 monthly"
  if ! listing="$(offhost_list 2>/dev/null)"; then
    log "ERROR: prune: cannot read $REENTRY_OFFHOST_DEST, the off-host copies were left untouched"
    return 1
  fi
  PRUNE_OK=off_check PRUNE_RM=off_rm PRUNE_LABEL="prune off-host"
  printf '%s\n' "$listing" | index_names | prune_index "$@" || r=1
  PRUNE_OK=checksum_ok PRUNE_RM=local_rm PRUNE_LABEL=prune
  return "$r"
}

cmd_prune() {
  local dry=0 d w m od ow om n rc=0
  case "${1:-}" in --dry-run) dry=1 ;; "") ;; *) die 2 "prune: unknown option $1" ;; esac
  d="${REENTRY_KEEP_DAILY:-7}"; w="${REENTRY_KEEP_WEEKLY:-4}"; m="${REENTRY_KEEP_MONTHLY:-6}"
  od="${REENTRY_OFFHOST_KEEP_DAILY:-$d}"; ow="${REENTRY_OFFHOST_KEEP_WEEKLY:-$w}"; om="${REENTRY_OFFHOST_KEEP_MONTHLY:-$m}"
  for n in "$d" "$w" "$m" "$od" "$ow" "$om"; do
    [[ $n =~ ^[0-9]+$ ]] || die 2 "prune: retention values must be whole numbers, got '$n'"
  done
  offhost_setup
  take_lock
  log "prune: keeping $d daily, $w weekly, $m monthly (dry run: $dry)"
  backup_index | prune_index "$dry" "$d" "$w" "$m" || rc=1
  prune_orphans "$dry"
  prune_offhost "$dry" "$od" "$ow" "$om" || rc=1
  [ "$dry" = 1 ] || catalog_update
  [ "$rc" = 0 ] || die 1 "prune: finished with problems, see the errors above"
  log "prune: done"
}

# Exit 1 if there are no backups or any is missing its checksum file or fails it.
cmd_list() {
  local k n state counts rc=0 any=0
  while IFS=$'\t' read -r k n; do
    any=1
    if checksum_ok "$n"; then state=ok
    elif [ -f "$BACKUP_DIR/$n.sha256" ]; then state=CHECKSUM-MISMATCH; rc=1
    else state=no-checksum; rc=1; fi
    if [ -f "$BACKUP_DIR/$n.counts" ]; then counts=counts; else counts=no-counts; fi
    printf '%s\t%s bytes\t%s\t%s\toff-host %s\n' "$n" "$(wc -c < "$BACKUP_DIR/$n" | tr -d ' ')" "$state" "$counts" "$(catalog_field "$n" 6 || echo unknown)"
  done < <(backup_index)
  if [ "$any" = 0 ]; then log "list: no backups in $BACKUP_DIR"; rc=1; fi
  return "$rc"
}

# age_text <seconds>
age_text() {
  local s=$1
  if [ "$s" -ge 86400 ]; then printf '%sd %sh' $((s/86400)) $((s%86400/3600))
  else printf '%sh %sm' $((s/3600)) $((s%3600/60)); fi
}

# One line per engine from the catalog, no Docker needed. Exit 1 if an engine has no backup, its
# newest backup fails its checksum, its newest good backup is older than REENTRY_MAX_AGE_HOURS
# (default 48), or an off-host destination is set and that backup has no verified copy there.
cmd_status() {
  local refresh="" engine db src n cs off off_at stamp epoch age latest="" newest="" newest_cs="" count=0 bad=0 rc=0
  local max="${REENTRY_MAX_AGE_HOURS:-48}" configured=0 want have
  case "${1:-}" in --refresh) refresh=force ;; "") ;; *) die 2 "status: unknown option $1" ;; esac
  [[ $max =~ ^[0-9]+$ ]] || die 2 "status: REENTRY_MAX_AGE_HOURS must be a whole number, got '$max'"
  load_env
  [ -z "${REENTRY_OFFHOST_DEST:-}" ] || configured=1
  if [ -n "$refresh" ]; then
    take_lock
    catalog_rebuild force || die 1 "status: could not write the catalog"
  fi
  [ -f "$CATALOG" ] || die 1 "status: no catalog in $BACKUP_DIR yet, take a backup or run: reentry status --refresh"
  want="$(backup_index | cut -f2 | LC_ALL=C sort)"; have="$(cut -f1 "$CATALOG" | LC_ALL=C sort)"
  if [ "$want" != "$have" ]; then
    log "status: WARN the catalog does not match the files in $BACKUP_DIR, run: reentry status --refresh"
  fi
  printf 'catalog %s, updated %s\n' "$CATALOG" "$(date -u -d "@$(stat -c %Y -- "$CATALOG")" +%Y-%m-%dT%H:%M:%SZ)"
  for engine in mysql postgres; do
    engine_setup "$engine"
    latest="" newest="" count=0 bad=0
    while IFS=$'\t' read -r n _ _ cs _ off off_at; do
      [[ $n == "${engine}_${db}_"* ]] || continue
      [ -n "$newest" ] || { newest=$n; newest_cs=$cs; }
      count=$((count+1))
      if [ "$cs" != ok ]; then bad=$((bad+1))
      elif [ -z "$latest" ]; then latest=$n; fi
    done < <(LC_ALL=C sort -t $'\t' -k1,1r "$CATALOG")
    if [ -z "$latest" ]; then
      printf '%s/%s\tno good backup\t%s backups, %s bad\n' "$engine" "$db" "$count" "$bad"
      log "status: PROBLEM $engine/$db has no good backup"; rc=1
    else
      [[ $latest =~ $BACKUP_RE ]]; stamp="${BASH_REMATCH[2]}"
      epoch="$(date -u -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s)"
      age=$(( $(date -u +%s) - epoch ))
      off="$(catalog_field "$latest" 6)"; off_at="$(catalog_field "$latest" 7)"
      printf '%s/%s\tlatest good %s\tage %s\tchecksum ok\toff-host %s\t%s backups, %s bad\n' \
        "$engine" "$db" "$latest" "$(age_text "$age")" "$([ "$off" = verified ] && echo "verified $off_at" || { [ "$configured" = 1 ] && echo missing || echo "not configured"; })" "$count" "$bad"
      [ "$newest" = "$latest" ] || { log "status: PROBLEM the newest $engine/$db backup $newest fails its checksum"; rc=1; }
      [ "$age" -le $((max*3600)) ] || { log "status: PROBLEM the latest good $engine/$db backup is older than $max hours"; rc=1; }
      [ "$configured" = 0 ] || [ "$off" = verified ] || { log "status: PROBLEM the latest good $engine/$db backup has no verified off-host copy"; rc=1; }
    fi
  done
  [ "$rc" = 0 ] || die 1 "status: problems found, see above"
  log "status: ok"
}

cmd_up() {
  need_docker; need_env
  compose up -d --wait
}

cmd_down() {
  need_docker; need_env
  if [ "${1:-}" != "--yes" ]; then
    [ -t 0 ] || die 2 "down deletes the database volumes, pass --yes to confirm"
    read -r -p "This deletes the MySQL and PostgreSQL data volumes. Type yes to go on: " answer
    [ "$answer" = yes ] || die 1 "aborted"
  fi
  compose down -v
}

usage() {
  cat >&2 <<'EOF'
usage: reentry <command>
  up       start the MySQL and PostgreSQL containers
  down     stop them and delete their data volumes (asks first, or pass --yes)
  backup   dump both databases to backups/ with SHA-256 checksums
  verify   restore the latest backups into throwaway containers and check them
  prune    apply retention (7 daily, 4 weekly, 6 monthly), add --dry-run to preview
  list     show backups with size, checksum state and off-host state
  status   latest good backup, age and off-host state per engine, from the catalog (--refresh re-hashes)
  restore  <mysql|postgres> [--backup FILE] [--target CONTAINER] [--database NAME] [--yes]
           restore the latest (or a named) backup into a running container, asks first
EOF
}

case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
  up|down|backup|verify|prune|list|status|restore|_backup-engine|_verify-engine) ;;
  *) usage; exit 2 ;;
esac

need_tools
parse_env
BACKUP_DIR="${REENTRY_BACKUP_DIR:-$ROOT/backups}"
CATALOG="$BACKUP_DIR/.catalog.tsv"

case "$1" in
  up) cmd_up ;;
  down) cmd_down "${2:-}" ;;
  backup) cmd_backup ;;
  verify) cmd_verify ;;
  prune) cmd_prune "${2:-}" ;;
  list) cmd_list ;;
  status) cmd_status "${2:-}" ;;
  restore) cmd_restore "${@:2}" ;;
  _backup-engine) cmd_backup_engine "${2:?engine}" ;;
  _verify-engine) cmd_verify_engine "${2:?engine}" ;;
esac
