# Copy to .env and change the passwords. .env is git-ignored.
MYSQL_ROOT_PASSWORD=change-me-mysql
MYSQL_DATABASE=shop
MYSQL_PORT=3307
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=shop
POSTGRES_PORT=5433
# Retention for ./reentry prune. These are the defaults.
# REENTRY_KEEP_DAILY=7
# REENTRY_KEEP_WEEKLY=4
# REENTRY_KEEP_MONTHLY=6
# Optional off-host copy after each backup. A folder (for example a mounted share) or host:/path
# for rsync over ssh. The folder must already exist. Letters, digits and _ . / @ : + - only.
# REENTRY_OFFHOST_DEST=/mnt/offhost-backups
# Optional encryption at rest: gpg or openssl, plus a file whose first line is the passphrase
# (it must not be empty).
# Keep that file outside the repo and out of the backup folder, with chmod 600. Losing it
# means losing the backups.
# REENTRY_ENCRYPT=openssl
# REENTRY_ENCRYPT_KEY_FILE=/path/to/reentry.key
# PBKDF2 iterations for new openssl backups, 10000 to 100000000 (default 600000). The count is
# stored next to each backup, so changing it never breaks restoring older backups.
# REENTRY_KDF_ITER=600000
# ./reentry status exits 1 when the latest good backup is older than this many hours (default 48).
# REENTRY_MAX_AGE_HOURS=48
# Optional failure notice after a failed backup, verify or off-host copy. Either or both.
# The command runs with REENTRY_EVENT and REENTRY_MESSAGE set. Quote it with single quotes.
# The webhook URL is a secret, so it belongs here and nowhere in the repo.
# REENTRY_NOTIFY_CMD='mail -s "$REENTRY_EVENT" ops@example.test <<< "$REENTRY_MESSAGE"'
# REENTRY_NOTIFY_WEBHOOK=https://hooks.example.test/services/your-secret
# Retention for the off-host copies, applied by ./reentry prune. They default to the local numbers.
# REENTRY_OFFHOST_KEEP_DAILY=7
# REENTRY_OFFHOST_KEEP_WEEKLY=4
# REENTRY_OFFHOST_KEEP_MONTHLY=6
