#!/usr/bin/env bash
# A stand-in for the docker command, used by test/fake.sh to exercise reentry without Docker.
# It answers the exact calls reentry makes with canned data. It proves the script logic only.
# Knobs (environment): FAKE_LOG, FAKE_DOWN=<container>, FAKE_FAIL_DUMP=1, FAKE_TRUNCATE=1,
# FAKE_DROP_ROW=1 (restored copy loses a row), FAKE_DRIFT=1 (live source gains a row).
# A container named reentry-empty-* has no database and no tables until it is created.
# Restores and CREATE DATABASE calls are written to FAKE_LOG as "load <container>" and "create <container>".
all="$*"
case "$1" in
  inspect)
    case "$all" in
      *State.Running*) [ "${FAKE_DOWN:-}" = "${*: -1}" ] && echo false || echo true ;;
      *reentry.verify*) case "${*: -1}" in reentry-verify-*) echo 1 ;; *) echo ;; esac ;;
      *) echo mysql:8.4 ;;
    esac
    exit 0 ;;
  run) echo "run $all" >> "${FAKE_LOG:-/dev/null}"; exit 0 ;;
  rm) echo "rm $all" >> "${FAKE_LOG:-/dev/null}"; exit 0 ;;
  exec) ;;
  *) exit 0 ;;
esac

shift
[ "$1" = -i ] && shift
container=$1

count_of() {
  local n
  case "$1" in customers) n=4 ;; products) n=5 ;; orders) n=6 ;; order_items) n=10 ;; *) n=0 ;; esac
  case "$container" in
    reentry-verify-*) [ "$1" = orders ] && [ -n "${FAKE_DROP_ROW:-}" ] && n=$((n-1)) ;;
    *) [ "$1" = orders ] && [ -n "${FAKE_DRIFT:-}" ] && n=$((n+1)) ;;
  esac
  echo "$n"
}

case "$all" in
  *mysqldump*|*pg_dump*)
    [ -z "${FAKE_FAIL_DUMP:-}" ] || exit 1
    echo "-- fake dump of sample tables"
    echo "INSERT INTO customers VALUES (1);"
    if [ -z "${FAKE_TRUNCATE:-}" ]; then
      case "$all" in *mysqldump*) echo "-- Dump completed on 2026-01-01" ;; *) echo "-- PostgreSQL database dump complete" ;; esac
    fi ;;
  *mysqladmin*|*pg_isready*) exit 0 ;;
  *"CREATE DATABASE"*) echo "create $container" >> "${FAKE_LOG:-/dev/null}"; exit 0 ;;
  *schemata*|*pg_database*)
    case "$container" in reentry-empty-*) grep -qx "create $container" "${FAKE_LOG:-/dev/null}" 2>/dev/null && echo 1 || echo 0 ;; *) echo 1 ;; esac ;;
  *mysqlcheck*) printf 'shop.customers  OK\nshop.orders  OK\n' ;;
  *information_schema*|*pg_tables*)
    case "$container" in reentry-empty-*) grep -qx "load $container" "${FAKE_LOG:-/dev/null}" 2>/dev/null || exit 0 ;; esac
    printf 'customers\nproducts\norders\norder_items\n' ;;
  *pg_constraint*|*"LEFT JOIN"*) echo 0 ;;
  *"SELECT COUNT(*) FROM "*)
    t="${all##*FROM }"; t="${t//\`/}"; t="${t//\"/}"; count_of "$t" ;;
  *) cat > /dev/null; echo "load $container" >> "${FAKE_LOG:-/dev/null}" ;; # a restore: read the dump from stdin
esac
